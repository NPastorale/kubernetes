{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>npastorale/workflows//renovate/default"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^(apps|argocd)/.+\\.yaml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^argocd/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "description": "CloudNativePG Cluster spec.imageName",
      "customType": "regex",
      "managerFilePatterns": [
        "/^apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "imageName:\\s*(?<depName>[^\\s:@]+/[^\\s:@]+):(?<currentValue>[^\\s@/]+)(?:@(?<currentDigest>\\S+))?"
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "imageName: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "description": "CloudNativePG extension image.reference",
      "customType": "regex",
      "managerFilePatterns": [
        "/^apps/.+\\.yaml$/"
      ],
      "matchStrings": [
        "reference:\\s*(?<depName>[^\\s:@]+/[^\\s:@]+):(?<currentValue>[^\\s@/]+)(?:@(?<currentDigest>\\S+))?"
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "reference: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "linuxserver.io: X.Y[.Z][.build][ubuNNNN][-rN][-commit]-lsN",
      "matchPackageNames": [
        "lscr.io/linuxserver/**"
      ],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?:\\.(?<build>\\d+))?(?<compatibility>ubu\\d+)?(?:-r\\d+)?(?:-[0-9a-f]{7,9})?-ls(?<revision>\\d+)$"
    },
    {
      // qbittorrent needs its own regex for two reasons:
      // 1. Upstream changed its tag scheme at ls454 to include the libtorrent
      //    version (`5.2.0_v2.0.12-ls454`), which the generic linuxserver rule
      //    above does not match.
      // 2. Its tags have no 4th numeric component, and Renovate's regex
      //    versioning ignores the `revision` group unless a `build` group is
      //    also captured. Mapping the `-lsN` number to `build` makes it part of
      //    the compared version, so ls-only rebuilds are picked up too.
      // Keep this scoped to qbittorrent: the generic rule works for the other
      // linuxserver images.
      "description": "linuxserver.io qbittorrent: X.Y.Z[-rN][_vA.B.C]-lsN (ls number mapped to build so it is compared)",
      "matchPackageNames": [
        "lscr.io/linuxserver/qbittorrent"
      ],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?:-r\\d+)?(?:_v\\d+\\.\\d+(?:\\.\\d+)?)?-ls(?<build>\\d+)$"
    },
    {
      "description": "Own images: X.Y.Z[-rN] (latest keeps default versioning for digest updates)",
      "matchPackageNames": [
        "ghcr.io/npastorale/**"
      ],
      "matchCurrentValue": "!/^latest$/",
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-r(?<build>\\d+))?$"
    },
    {
      "description": "CloudNativePG extensions: X.Y.Z-<timestamp>-<pg major>-<distro>",
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/pgvector"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d{12})-(?<compatibility>\\d+-\\w+)$"
    },
    {
      "description": "Argo CD apps tracking HEAD of a Git repo",
      "matchManagers": [
        "argocd"
      ],
      "matchCurrentValue": "/^HEAD$/",
      "enabled": false
    }
  ]
}